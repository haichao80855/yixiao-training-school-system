# ==============================================================================
# 拓视未来教育「一校教培系统」前端生产环境变量配置 (.env.production)
# ==============================================================================

# 数据源模式：强制使用远端真实数据库后端 (remote)
VITE_DATA_SOURCE=remote

# API 基础路径：由生产 Nginx 统一反向代理至 /api/
VITE_API_BASE_URL=/api
