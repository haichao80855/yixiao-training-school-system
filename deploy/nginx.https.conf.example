# ==============================================================================
# 拓视未来教育「一校教培系统」HTTPS 生产 Nginx 配置模板
# 微信小程序要求后端为已备案的 HTTPS 域名。准备好域名与证书后：
#   1. 把下面所有 yixiao.example.com 换成你的域名，放好证书文件
#   2. 用本文件替换 deploy/nginx.conf (Docker 方式需在 docker-compose 中映射 443 端口与证书目录)
#   3. nginx -t 校验通过后再 reload
#   4. 小程序后台把该域名加入 request / uploadFile / downloadFile 合法域名
# ==============================================================================

# HTTP 全部跳转到 HTTPS
server {
    listen 80;
    server_name yixiao.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name yixiao.example.com;  # TODO 换成已备案并解析到本服务器的域名

    # TODO 在阿里云「数字证书管理服务」申请免费证书，下载 Nginx 版放到以下路径
    ssl_certificate     /etc/nginx/ssl/yixiao.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/yixiao.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;
    index index.html;

    # 客户端上传报文体限制：课堂视频后端上限 100MB，留出 multipart 报文余量
    client_max_body_size 110M;
    client_body_timeout 300s;

    # 深度开启 Gzip 传输压缩
    gzip on;
    gzip_min_length 1k;
    gzip_buffers 4 16k;
    gzip_http_version 1.1;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;
    gzip_vary on;
    gzip_disable "MSIE [1-6]\.";

    # 媒体不再按 /uploads/ 公开访问：接口返回限时签名链接 (本地存储 /api/media/...，OSS 预签名地址)
    location ^~ /uploads/ {
        return 404;
    }

    # 前端带哈希的构建静态资源开启超长强缓存
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|webp)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # 前端 SPA 页面路由支持 (刷新不 404)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # API 接口反向代理至 NestJS 后端微服务
    # ^~ 前缀优先于图片后缀正则，避免签名媒体路由 /api/media/x.jpg 被当成前端静态资源 404
    location ^~ /api/ {
        # docker-compose 服务间通信使用容器名 backend:3001
        proxy_pass http://backend:3001/api/;
        proxy_http_version 1.1;

        # 传递真实请求头与客户端网络拓扑信息
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Campus-Id $http_x_campus_id;

        # WebSocket 支持 (备用)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 超时设置
        proxy_connect_timeout 60s;
        # 100MB 视频在弱网下上传较慢
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # 错误页面友好兜底
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
