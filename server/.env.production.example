# ==============================================================================
# 拓视未来教育「一校教培系统」阿里云生产环境服务端配置 (server/.env.production)
# ==============================================================================

# 服务端口
PORT=3001
NODE_ENV=production

# 阿里云 RDS PostgreSQL 连接串 (请替换为您的 RDS 专有网络内网主机名与真实凭证)
# 格式: postgresql://<user>:<password>@<rds-inner-host>:5432/<dbname>?schema=public&connection_limit=30
DATABASE_URL="postgresql://yixiao_app:YourStrongPassword123!@pg-xxxxxxxx.pg.rds.aliyuncs.com:5432/yixiao_prod?schema=public&connection_limit=30"

# JWT 生产鉴权密钥 (建议使用至少 32 位的随机强密钥)
JWT_SECRET="shengtong_edu_prod_jwt_secret_2026_super_secure_key"
JWT_EXPIRES_IN="7d"

# 默认集团总部校区编码
DEFAULT_CAMPUS_CODE="campus-bj-hq"

# 阿里云 OSS / CDN 配置 (选填，用于课件与静态媒体加速)
OSS_REGION="oss-cn-beijing"
OSS_BUCKET="yixiao-coursewares-prod"
OSS_CDN_DOMAIN="https://coursewares.yixiao-edu.com"

# 课件来源切换 (盛通 / 百家云原链接 <-> 本 Bucket courseware/ 下的备份，见 deploy/courseware-mirror/README.md)
# 自动探测原平台是否可用：STORAGE_ENGINE=oss 时默认开启，on / off 可强制
COURSEWARE_PROBE=""
# 探测间隔 (分钟)，默认 10
COURSEWARE_PROBE_INTERVAL_MIN=""
# 百家云白板不可用时，用 Office Online 预览备份的 pptx (会把限时文件链接交给微软)；off = 只提供下载
COURSEWARE_OFFICE_PREVIEW=""
# 原平台故障 / 恢复时的群机器人告警 (钉钉或企业微信 Webhook，钉钉关键词可填：备份)
ALERT_WEBHOOK_URL=""
