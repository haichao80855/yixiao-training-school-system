# 拓视未来教育「一校教培系统」后端服务配置模板
# 复制为 server/.env 后按需修改；server/.env 已被 .gitignore 排除，请勿提交真实密钥。

PORT=3001

# 数据库连接字符串
# 本地开发默认开箱即用 SQLite（0 外部依赖，数据持久化保存在 server/prisma/dev.db）
# 切换到 MySQL 时只需改为:
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/yixiao"
# 切换到 PostgreSQL 时只需改为:
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/yixiao?schema=public"
DATABASE_URL="file:./dev.db"

# JWT 身份鉴权密钥与时效
JWT_SECRET="replace-with-your-own-secret"
JWT_EXPIRES_IN="7d"

# 默认校区编码
DEFAULT_CAMPUS_CODE="CAMPUS_MAIN"

# 媒体签名链接 (家长端)：本地磁盘存储时 /api/media/<key>?exp=&sig= 的签名密钥，未配置时回退 JWT_SECRET
MEDIA_SIGNING_SECRET="replace-with-your-own-media-secret"
# 媒体链接对外访问前缀 (小程序需完整 https 域名)，留空则返回相对路径 /api/media/...
MEDIA_PUBLIC_BASE_URL=""

# 微信小程序 (家长端登录时用 wx.login code 换取 openid，留空则跳过)
WECHAT_MP_APPID=""
WECHAT_MP_SECRET=""
