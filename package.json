{
  "name": "yixiao-training-school-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "server:dev": "cd server && npm run start:dev",
    "server:build": "cd server && npm run build",
    "test:server": "cd server && node test-auth-and-system.js && node test-curriculum-and-student.js && node test-educational-and-attendance.js && node test-financial-and-approval.js",
    "test:fullstack": "node tests/e2e_full_stack_integration.cjs",
    "test:e2e:walkthrough": "node scripts/e2e_all_functions_browser_walkthrough.cjs",
    "test:all": "node tests/runner.js && node tests/e2e_full_stack_integration.cjs && cd server && node test-auth-and-system.js && node test-curriculum-and-student.js && node test-educational-and-attendance.js && node test-financial-and-approval.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.3",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.441.0",
    "pinia": "^2.2.2",
    "vue": "^3.5.8",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.16.5",
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vue-tsc": "^2.1.6"
  }
}
