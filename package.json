{
  "name": "yixiao-training-school-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:ui": "node scripts/ui-lint.cjs",
    "type-check": "vue-tsc --noEmit",
    "server:dev": "cd server && npm run start:dev",
    "server:build": "cd server && npm run build",
    "test:server": "node tests/isolated-env.cjs --scope=server",
    "test:backup": "python3 -W ignore::ResourceWarning deploy/backup/test_yixiao_db_backup.py",
    "test:fullstack": "node tests/isolated-env.cjs --file=e2e_full_stack_integration",
    "test:all": "node tests/run_all_unified.cjs",
    "db:stats": "node scripts/db_stats.cjs",
    "db:clear:students": "node scripts/clear_student_data.cjs",
    "db:clear:classes": "node scripts/clear_class_data.cjs",
    "mp:dev": "cd mini-program && npm run dev:mp-weixin",
    "mp:build": "cd mini-program && npm run build:mp-weixin",
    "mp:type-check": "cd mini-program && npm run type-check",
    "test:isolated": "node tests/isolated-env.cjs",
    "test:suite": "node tests/run-suite.cjs",
    "check:bundle": "node scripts/check-bundle-size.cjs",
    "test:smoke": "npm run build && node tests/isolated-env.cjs --scope=smoke",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.3",
    "lucide-vue-next": "^0.441.0",
    "mediabunny": "1.62.0",
    "pinia": "^2.2.2",
    "vue": "^3.5.8",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@vitejs/plugin-vue": "^5.1.3",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "25.0.1",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.6",
    "vitest": "2.1.9",
    "vue-tsc": "^2.1.6"
  }
}
